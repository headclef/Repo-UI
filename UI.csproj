<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <Authors>headclef</Authors>
    <Version>1.3.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Add Package Sources -->
  <PropertyGroup>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json; <!-- Official NuGet Feed -->
      https://nuget.bepinex.dev/v3/index.json; <!-- BepInEx NuGet Feed -->
      https://nuget.windows10ce.com/nuget/v3/index.json <!-- ThunderStore Staff Feed -->
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Reference\**" />
  </ItemGroup>

  <!-- Package References -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all"/>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" IncludeAssets="build" />
    <PackageReference Include="Linkoid.Repo.Plugin.Build" Version="*" PrivateAssets="all" />
    
    <PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all"/>
    <PackageReference Include="R.E.P.O.GameLibs.Steam" Version="*-*" PrivateAssets="all" />
  </ItemGroup>

  <!-- Reference to Improve and IncreaseTumbleDamage mods (compile-only, not bundled) -->
  <ItemGroup>
    <Reference Include="Improve">
      <HintPath>..\Improve\bin\Debug\netstandard2.1\Improve.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Character Stats">
      <HintPath>..\Character Stats\bin\Debug\netstandard2.1\Character Stats.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="IncreaseTumbleDamage">
      <HintPath>..\Increase Tumble Damage\bin\Debug\netstandard2.1\Increase Tumble Damage.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Berserk">
      <HintPath>..\Berserk\bin\Debug\netstandard2.1\Berserk.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
